{
  "name": "cloud-pos-caja",
  "version": "1.0.0",
  "appMode": "CAJA",
  "description": "Cloud POS - Terminal de Caja (Punto de Venta)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:portable": "electron-builder --win portable --x64"
  },
  "author": "Cloud POS Team",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.cloudpos.desktop.caja",
    "productName": "Cloud POS - Caja",
    "copyright": "Copyright © 2026 Cloud POS",
    "directories": {
      "output": "dist-caja"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon-caja.ico"
    },
    "portable": {
      "artifactName": "Cloud POS - Caja.exe"
    }
  }
}